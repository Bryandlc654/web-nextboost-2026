# ============================================================
# Next Boost - Configuracion Apache
# ============================================================

# ---- Canonicalizacion: HTTPS + no-www (solo dominio de produccion) ----
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1) Forzar HTTPS (respeta proxies que ya terminan TLS)
    RewriteCond %{HTTP_HOST} (^|\.)nextboost\.business [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2) Redirigir www -> sin www
    RewriteCond %{HTTP_HOST} ^www\.nextboost\.business [NC]
    RewriteRule ^ https://nextboost.business%{REQUEST_URI} [L,R=301]
</IfModule>

# ---- Compresion GZIP ----
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# ---- Cache del navegador ----
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 6 months"
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType image/svg+xml "access plus 6 months"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Bloquear acceso directo a archivos sensibles
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<Files ".env.example">
    Require all denied
</Files>
